{%- comment -%}
  Above-the-fold star rating.

  COMPLIANCE: this renders ONLY from `product.metafields.reviews.*`, the standard
  metafield that verified-buyer apps (Judge.me, Loox, Shopify Product Reviews)
  populate. There is deliberately no manual rating field anywhere in this block's
  schema, so an invented rating cannot be entered by mistake.

  Until real reviews exist it renders nothing at all — not "0 reviews", not an
  empty star row. Once a review app is installed, it appears on its own with no
  theme change. See COMPLIANCE.md.

  Accepts:
  - block: {Object} the main-product block
  - product: {Object}
{%- endcomment -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
-%}

{%- if rating != blank and rating.rating > 0 -%}
  {%- liquid
    assign count_label = ''
    if rating_count != blank and rating_count > 0
      assign count_label = rating_count | append: ' reviews'
      if rating_count == 1
        assign count_label = '1 review'
      endif
    endif
  -%}

  <div class="sw-product-rating" {{ block.shopify_attributes }}>
    {%- render 'stridewell-stars', rating: rating.rating, count: count_label -%}

    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="sw-sizing-help">
        {{- block.settings.link_label | default: 'Read reviews' | escape -}}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
