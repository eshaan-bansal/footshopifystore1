{%- comment -%}
  Quantity-break offer block.

  Three tiers, each a radio that sets the product form's quantity. One tier can
  be flagged "Most Popular" (the anchor); a cheaper single-unit tier sits above
  it as the decoy so the middle option looks like the obvious choice.

  IMPORTANT: this block controls QUANTITY and LABELS only. The saving itself
  must exist as a real automatic discount (or bundle app) in Shopify admin,
  otherwise the price the customer reads here will not match checkout.

  Accepts:
  - block: {Object} the main-product block
  - product_form_id: {String} id of Dawn's product form
{%- endcomment -%}

{%- liquid
  assign tier_count = 0
  for i in (1..3)
    assign label_key = 'tier_' | append: i | append: '_label'
    if block.settings[label_key] != blank
      assign tier_count = tier_count | plus: 1
    endif
  endfor
-%}

{%- if tier_count > 0 -%}
  <script src="{{ 'stridewell-offer.js' | asset_url }}" defer="defer"></script>

  <stridewell-offer
    class="sw-offer"
    data-form-id="{{ product_form_id }}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <p class="sw-offer__heading">{{ block.settings.heading | escape }}</p>
    {%- endif -%}

    <fieldset class="sw-offer__tiers">
      <legend class="visually-hidden">
        {{- block.settings.heading | default: 'Choose a quantity' | escape -}}
      </legend>

      {%- for i in (1..3) -%}
        {%- liquid
          assign label_key = 'tier_' | append: i | append: '_label'
          assign note_key = 'tier_' | append: i | append: '_note'
          assign qty_key = 'tier_' | append: i | append: '_quantity'
          assign price_key = 'tier_' | append: i | append: '_price'
          assign compare_key = 'tier_' | append: i | append: '_compare_price'
          assign popular_key = 'tier_' | append: i | append: '_popular'

          assign tier_label = block.settings[label_key]
          assign tier_note = block.settings[note_key]
          assign tier_quantity = block.settings[qty_key] | default: 1
          assign tier_price = block.settings[price_key]
          assign tier_compare = block.settings[compare_key]
          assign tier_popular = block.settings[popular_key]
        -%}

        {%- if tier_label != blank -%}
          <label
            class="sw-offer__tier{% if tier_popular %} sw-offer__tier--popular{% endif %}"
            for="{{ block.id }}-tier-{{ i }}"
          >
            {%- if tier_popular and block.settings.popular_label != blank -%}
              <span class="sw-offer__flag">{{ block.settings.popular_label | escape }}</span>
            {%- endif -%}

            <input
              type="radio"
              class="sw-offer__radio"
              id="{{ block.id }}-tier-{{ i }}"
              name="{{ block.id }}-tier"
              value="{{ tier_quantity }}"
              {% if tier_popular %}checked{% endif %}
            >

            <span class="sw-offer__label">{{ tier_label | escape }}</span>

            {%- if tier_note != blank -%}
              <span class="sw-offer__note sw-muted">{{ tier_note | escape }}</span>
            {%- endif -%}

            {%- if tier_price != blank -%}
              <span class="sw-offer__price">
                {{- tier_price | escape -}}
                {%- if tier_compare != blank -%}
                  <s>{{ tier_compare | escape }}</s>
                {%- endif -%}
              </span>
            {%- endif -%}
          </label>
        {%- endif -%}
      {%- endfor -%}
    </fieldset>

    {%- if block.settings.footnote != blank -%}
      <p class="sw-offer__footnote sw-muted">{{ block.settings.footnote | escape }}</p>
    {%- endif -%}
  </stridewell-offer>
{%- endif -%}
