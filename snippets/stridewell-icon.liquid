{%- comment -%}
  Renders an inline SVG icon from the StrideWell icon set.

  Inline SVG (rather than an icon font or sprite request) keeps the icons
  render-blocking-free and lets them inherit `currentColor` from whatever
  colour scheme the section is using.

  Accepts:
  - icon: {String} icon name — see the `case` below for the full list.
           An unknown name renders nothing at all (graceful degradation).
  - class: {String} extra classes. Sizing modifiers: sw-icon--sm, sw-icon--lg
  - stroke_width: {Number} override stroke weight (default from CSS)

  Usage:
  {%- render 'stridewell-icon', icon: 'shield-check', class: 'sw-icon--lg' -%}
{%- endcomment -%}

{%- liquid
  assign icon_class = 'sw-icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}

{%- case icon -%}
  {%- when 'truck' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M1 3h13v13H1z"/>
      <path d="M14 8h4l3 3v5h-7"/>
      <circle cx="5.5" cy="19" r="2"/>
      <circle cx="17.5" cy="19" r="2"/>
      <path d="M7.5 19h8"/>
    </svg>

  {%- when 'shield-check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6z"/>
      <path d="m8.75 11.75 2.25 2.25 4.25-4.5"/>
    </svg>

  {%- when 'users' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M15.5 20v-1.5a4 4 0 0 0-4-4h-5a4 4 0 0 0-4 4V20"/>
      <circle cx="9" cy="7.5" r="3.5"/>
      <path d="M21.5 20v-1.5a4 4 0 0 0-3-3.87"/>
      <path d="M15.5 4.13a4 4 0 0 1 0 6.74"/>
    </svg>

  {%- when 'ruler' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M2.5 15.5 15.5 2.5 21.5 8.5 8.5 21.5z"/>
      <path d="M6 12l2 2M9 9l2 2M12 6l2 2"/>
    </svg>

  {%- when 'check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="m4.5 12.5 5 5 10-11"/>
    </svg>

  {%- when 'check-circle' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <circle cx="12" cy="12" r="9.25"/>
      <path d="m8 12.25 2.75 2.75L16.25 9.5"/>
    </svg>

  {%- when 'star' -%}
    <svg class="{{ icon_class }} sw-icon--star" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
      <path d="M12 2.5l2.95 5.98 6.6.96-4.77 4.65 1.12 6.57L12 17.55l-5.9 3.11 1.13-6.57L2.45 9.44l6.6-.96z"/>
    </svg>

  {%- when 'star-half' -%}
    <svg class="{{ icon_class }} sw-icon--star" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
      <path d="M12 2.5v15.05l-5.9 3.11 1.13-6.57L2.45 9.44l6.6-.96z"/>
    </svg>

  {%- when 'lock' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <rect x="4" y="10.5" width="16" height="11" rx="2"/>
      <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>
    </svg>

  {%- when 'refresh' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"/>
      <path d="M20.5 4v5h-5"/>
    </svg>

  {%- when 'clock' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <circle cx="12" cy="12" r="9.25"/>
      <path d="M12 7v5.5l3.5 2"/>
    </svg>

  {%- when 'footprint' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M8.5 14.5c-2 0-3-1.6-3-4.2C5.5 6.4 7 2.5 10 2.5c2.2 0 3 2 3 4.6 0 2.2-.6 3.7-1.4 5.1-.6 1-1.6 2.3-3.1 2.3z"/>
      <path d="M9.5 17.5c1.9 0 3 .9 3 2.1 0 1.2-1.2 1.9-3 1.9s-3-.7-3-1.9c0-1.2 1.1-2.1 3-2.1z"/>
      <path d="M17 9.5c1.2 0 1.9 1 1.9 2.4 0 1.9-.9 3.6-2.4 3.6-1.1 0-1.8-1-1.8-2.4 0-1.8.9-3.6 2.3-3.6z"/>
    </svg>

  {%- when 'arch' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M3 18.5h18"/>
      <path d="M3 18.5c0-6 4-11 9-11s9 5 9 11"/>
      <path d="M8 18.5c0-3.3 1.8-6 4-6s4 2.7 4 6"/>
    </svg>

  {%- when 'sock' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M8 2.5h7v8.2c0 1.4.5 2 1.6 2.9l1.6 1.3a3.6 3.6 0 0 1-2 6.4 3.9 3.9 0 0 1-2.6-1l-4.9-4.3A5 5 0 0 1 6 12.2V2.5z"/>
      <path d="M8 6.5h7"/>
    </svg>

  {%- when 'shoe' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M2.5 17.5h19a0 0 0 0 0 0 0v-1.7c0-1.3-.9-2.4-2.2-2.7l-4.6-1a3 3 0 0 1-1.5-.9L11 8.5H5a2.5 2.5 0 0 0-2.5 2.5z"/>
      <path d="M2.5 17.5h19"/>
      <path d="M7 8.5v3M10.5 11l1.5 1.5"/>
    </svg>

  {%- when 'knee' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M9 2.5v5.3c0 1.2-.4 2-1.2 2.9l-1.4 1.5a4 4 0 0 0-1 2.7v6.6"/>
      <path d="M15 2.5v5.3c0 1.2.4 2 1.2 2.9l1.4 1.5a4 4 0 0 1 1 2.7v6.6"/>
      <path d="M5.5 11.5h13"/>
    </svg>

  {%- when 'wave' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M2.5 8.5c2 0 2.6-2 4.75-2s2.75 2 4.75 2 2.6-2 4.75-2 2.75 2 4.75 2"/>
      <path d="M2.5 14c2 0 2.6-2 4.75-2s2.75 2 4.75 2 2.6-2 4.75-2 2.75 2 4.75 2"/>
      <path d="M2.5 19.5c2 0 2.6-2 4.75-2s2.75 2 4.75 2 2.6-2 4.75-2 2.75 2 4.75 2"/>
    </svg>

  {%- when 'heart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M12 20.5s-8-4.9-8-10a4.6 4.6 0 0 1 8-3 4.6 4.6 0 0 1 8 3c0 5.1-8 10-8 10z"/>
    </svg>

  {%- when 'cushion' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <rect x="2.5" y="7.5" width="19" height="9" rx="4.5"/>
      <path d="M7 12h10"/>
    </svg>

  {%- when 'target' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <circle cx="12" cy="12" r="9.25"/>
      <circle cx="12" cy="12" r="5"/>
      <circle cx="12" cy="12" r="1.25"/>
    </svg>

  {%- when 'sun' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <circle cx="12" cy="12" r="4.5"/>
      <path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"/>
    </svg>

  {%- when 'chat' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M21 12.5a7.5 7.5 0 0 1-7.5 7.5H8l-5 2.5 1.4-4A7.5 7.5 0 0 1 10.5 5h3A7.5 7.5 0 0 1 21 12.5z"/>
    </svg>

  {%- when 'tag' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M20.5 13.5 13 21a2 2 0 0 1-2.8 0L3 13.8V3.5h10.3l7.2 7.2a2 2 0 0 1 0 2.8z"/>
      <circle cx="7.75" cy="8.25" r="1.25"/>
    </svg>

  {%- when 'map-pin' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M12 21.5s7-5.6 7-11a7 7 0 0 0-14 0c0 5.4 7 11 7 11z"/>
      <circle cx="12" cy="10.25" r="2.6"/>
    </svg>

  {%- when 'route' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <circle cx="5.5" cy="18.5" r="2.5"/>
      <circle cx="18.5" cy="5.5" r="2.5"/>
      <path d="M8 18.5h6a4 4 0 0 0 0-8H10a4 4 0 0 1 0-8h6"/>
    </svg>

  {%- when 'return-arrow' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M9 5.5 3.5 11 9 16.5"/>
      <path d="M3.5 11h11a6 6 0 0 1 0 12h-3"/>
    </svg>

  {%- when 'flag' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M5 21.5V3.5c4-1.6 8 1.6 12 0v11c-4 1.6-8-1.6-12 0"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true"{% if stroke_width %} stroke-width="{{ stroke_width }}"{% endif %}>
      <path d="M4 12h16M14 6l6 6-6 6"/>
    </svg>
{%- endcase -%}
