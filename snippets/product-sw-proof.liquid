{%- comment -%}
  Reassurance / objection handling.

  COMPLIANCE: facts only — fit, materials, which shoes it works with, and a real
  policy line. No ratings or review counts live here: real ratings come from
  `product.metafields.reviews` via the rating block. No health-outcome claims.
  See COMPLIANCE.md.

  Accepts:
  - block: {Object} the main-product block
{%- endcomment -%}

{%- liquid
  assign point_count = 0
  for i in (1..4)
    assign key = 'point_' | append: i
    if block.settings[key] != blank
      assign point_count = point_count | plus: 1
    endif
  endfor
-%}

{%- if point_count > 0 or block.settings.guarantee_text != blank -%}
  <div class="sw-proof" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="sw-proof__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if point_count > 0 -%}
      <ul class="sw-proof__list" role="list">
        {%- for i in (1..4) -%}
          {%- liquid
            assign key = 'point_' | append: i
            assign point = block.settings[key]
          -%}
          {%- if point != blank -%}
            <li>
              {%- render 'stridewell-icon', icon: 'check-circle', class: 'sw-icon--sm' -%}
              <span>{{ point }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if block.settings.guarantee_text != blank -%}
      <p class="sw-product-cue">
        {%- render 'stridewell-icon', icon: 'refresh', class: 'sw-icon--sm' -%}
        <span>{{ block.settings.guarantee_text | escape }}</span>
      </p>
    {%- endif -%}
  </div>
{%- endif -%}
