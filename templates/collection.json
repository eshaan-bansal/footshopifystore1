{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "intro": {
      "type": "rich-text",
      "settings": {
        "desktop_content_position": "left",
        "content_alignment": "left",
        "color_scheme": "scheme-1",
        "full_width": false,
        "padding_top": 8,
        "padding_bottom": 24
      },
      "blocks": {
        "intro-text": {
          "type": "text",
          "settings": {
            "text": "<p>Everything here is made for one customer: someone on their feet all day. Filter by size or type below, or <a href=\"/pages/sizing-guide\">check the sizing guide</a> first. Free US shipping over $50 and tracking on every order.</p>"
          }
        }
      },
      "block_order": [
        "intro-text"
      ]
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 24,
        "padding_bottom": 36
      }
    },
    "trust-bar": {
      "type": "trust-bar",
      "settings": {
        "heading": "",
        "layout": "inline",
        "color_scheme": "scheme-2",
        "padding_top": 32,
        "padding_bottom": 32
      },
      "blocks": {
        "trust-shipping": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "label": "Free US shipping",
            "sublabel": "On orders over $50"
          }
        },
        "trust-guarantee": {
          "type": "item",
          "settings": {
            "icon": "clock",
            "label": "Tracking on every order",
            "sublabel": "Emailed as soon as it ships"
          }
        },
        "trust-sizing": {
          "type": "item",
          "settings": {
            "icon": "ruler",
            "label": "Sizing guide",
            "sublabel": "Check your fit before you order"
          }
        },
        "trust-secure": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "label": "Secure checkout",
            "sublabel": "Encrypted at every step"
          }
        }
      },
      "block_order": [
        "trust-shipping",
        "trust-guarantee",
        "trust-sizing",
        "trust-secure"
      ]
    },
    "faq": {
      "type": "collapsible-content",
      "settings": {
        "caption": "",
        "heading": "Questions people ask before ordering",
        "heading_size": "h2",
        "heading_alignment": "center",
        "layout": "section",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 40,
        "padding_bottom": 52
      },
      "blocks": {
        "faq-sizing": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which size should I order?",
            "icon": "ruler",
            "row_content": "<p>Order the size that matches your usual shoe size. If you are between sizes, or you wear a wide fit, size up. Every product page lists its size range, and the Sizing Guide walks you through measuring your foot in about a minute.</p>"
          }
        },
        "faq-shipping": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How fast will my order arrive?",
            "icon": "truck",
            "row_content": "<p>Orders are dispatched within 1–2 business days. Standard US delivery then typically takes 5–8 business days, and shipping is free on orders over $50.</p>"
          }
        },
        "faq-returns": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I return something?",
            "icon": "return",
            "row_content": "<p>Yes. The full terms, including the return window, are on our <a href=\"/policies/refund-policy\">Refund policy</a> page. If you are unsure about fit, email us before ordering and we will help you choose.</p>"
          }
        }
      },
      "block_order": [
        "faq-sizing",
        "faq-shipping",
        "faq-returns"
      ]
    }
  },
  "order": [
    "banner",
    "intro",
    "product-grid",
    "trust-bar",
    "faq"
  ]
}
