{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "intro": {
      "type": "rich-text",
      "settings": {
        "desktop_content_position": "left",
        "content_alignment": "left",
        "color_scheme": "scheme-1",
        "full_width": false,
        "padding_top": 8,
        "padding_bottom": 24
      },
      "blocks": {
        "intro-text": {
          "type": "text",
          "settings": {
            "text": "<p>Everything here is made for one customer: someone on their feet all day. Each product page lists its materials, size range and fit notes in full — and if you are between options, email us before you order. Free US shipping over $50 and tracking on every order.</p>"
          }
        }
      },
      "block_order": [
        "intro-text"
      ]
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 24,
        "padding_bottom": 36
      }
    },
    "trust-bar": {
      "type": "trust-bar",
      "settings": {
        "heading": "",
        "layout": "inline",
        "color_scheme": "scheme-2",
        "padding_top": 32,
        "padding_bottom": 32
      },
      "blocks": {
        "trust-shipping": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "label": "Free US Shipping",
            "sublabel": "On orders over $50"
          }
        },
        "trust-tracking": {
          "type": "item",
          "settings": {
            "icon": "map-pin",
            "label": "Tracking on Every Order",
            "sublabel": "Follow it to your door"
          }
        },
        "trust-secure": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "label": "Secure Checkout",
            "sublabel": "SSL-encrypted payments"
          }
        },
        "trust-states": {
          "type": "item",
          "settings": {
            "icon": "flag",
            "label": "Ships to All 50 States",
            "sublabel": "Every US address"
          }
        }
      },
      "block_order": [
        "trust-shipping",
        "trust-tracking",
        "trust-secure",
        "trust-states"
      ]
    },
    "faq": {
      "type": "collapsible-content",
      "settings": {
        "caption": "",
        "heading": "Questions people ask before ordering",
        "heading_size": "h2",
        "heading_alignment": "center",
        "layout": "section",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 40,
        "padding_bottom": 52
      },
      "blocks": {
        "faq-sizing": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which size should I order?",
            "icon": "ruler",
            "row_content": "<p>Foot-worn items are sized to your usual shoe size — if you are between sizes or wear a wide fit, size up. Calf, knee and ankle items are sized by measuring around the limb at its widest point, not by shoe size. Every product page lists its own size range, and if you are still unsure, email us your measurements before you order.</p>"
          }
        },
        "faq-shipping": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "truck",
            "row_content": "<p>Delivery times vary by item, so we don't quote a single window. You'll get a tracking link by email as soon as your order ships, and you can follow it the whole way. Shipping is free on US orders over $50.</p>"
          }
        },
        "faq-pre-order": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Not sure which one to order?",
            "icon": "chat_bubble",
            "row_content": "<p>Email us before you order. Tell us your shoe size or what you're looking for and we'll tell you which option fits — it's much easier than guessing and sending something back.</p>"
          }
        }
      },
      "block_order": [
        "faq-sizing",
        "faq-shipping",
        "faq-pre-order"
      ]
    }
  },
  "order": [
    "banner",
    "intro",
    "product-grid",
    "trust-bar",
    "faq"
  ]
}
