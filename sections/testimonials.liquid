{%- comment -%}
  Testimonials.

  COMPLIANCE: ships with NO blocks and therefore renders nothing. Under the FTC
  Rule on Consumer Reviews and Testimonials, a placeholder quote on a live
  storefront is a representation to a customer — so this section has no example
  content to accidentally leave in.

  Add a block only when you have a real review from a real buyer, and only enter
  a rating that review actually gave. If you install a review app (Judge.me,
  Loox), prefer its own section over this one. See COMPLIANCE.md.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .sw-testimonials__grid {
    --sw-testimonial-columns: {{ section.blocks.size | at_most: 3 | at_least: 1 }}; /* upper bound; empty blocks are skipped */
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # Count only blocks that actually carry a quote. A section with no real
  # reviews must render nothing at all — not a heading over an empty grid.
  assign real_reviews = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign real_reviews = real_reviews | plus: 1
    endif
  endfor
-%}

{%- if real_reviews > 0 -%}
<div class="sw-testimonials color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank or section.settings.summary != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin sw-center sw-measure">
        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.summary_rating > 0 -%}
          <p class="sw-center">
            {%- render 'stridewell-stars',
              rating: section.settings.summary_rating,
              count: section.settings.summary
            -%}
          </p>
        {%- elsif section.settings.summary != blank -%}
          <p class="sw-muted">{{ section.settings.summary | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sw-testimonials__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.quote == blank -%}
            {%- continue -%}
          {%- endif -%}
          <li {{ block.shopify_attributes }}>
            <figure class="sw-testimonial">
              {%- if block.settings.rating > 0 -%}
                {%- render 'stridewell-stars', rating: block.settings.rating -%}
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                <blockquote class="sw-testimonial__quote">{{ block.settings.quote }}</blockquote>
              {%- endif -%}

              {%- if block.settings.name != blank or block.settings.meta != blank or block.settings.avatar != blank -%}
                <figcaption class="sw-testimonial__footer">
                  {%- if block.settings.avatar != blank -%}
                    {{
                      block.settings.avatar
                      | image_url: width: 132
                      | image_tag:
                        class: 'sw-testimonial__avatar',
                        widths: '44, 88, 132',
                        sizes: '44px',
                        alt: block.settings.name
                    }}
                  {%- endif -%}
                  <span>
                    {%- if block.settings.name != blank -%}
                      <span class="sw-testimonial__name">{{ block.settings.name | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.meta != blank -%}
                      <span class="sw-testimonial__meta sw-muted">{{ block.settings.meta | escape }}</span>
                    {%- endif -%}
                  </span>
                </figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "class": "section",
  "tag": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a block for each REAL review from a real buyer. This section renders nothing while it has no blocks, which is the correct state until you have collected reviews. Never enter an invented quote, rating or review count — see COMPLIANCE.md."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What customers tell us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__4.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "summary_rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "label": "Overall rating",
      "info": "Set to 0 to hide. Only use your real average.",
      "default": 0
    },
    {
      "type": "text",
      "id": "summary",
      "label": "Rating caption",
      "info": "e.g. \"based on 412 reviews\". Leave blank to hide."
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "label": "Rating",
          "info": "The rating this reviewer actually gave. 0 hides the stars.",
          "default": 0
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": ""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": ""
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Supporting line",
          "info": "Optional context for this reviewer. Only call someone a verified buyer if they actually are.",
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials (empty — add real reviews)"
    }
  ]
}
{% endschema %}
