{%- comment -%}
  Shop by problem — the intent bridge for Google traffic.

  Card titles deliberately use the visitor's own search language ("plantar
  fasciitis", "bunions", "swelling") and route to the matching collection or a
  filtered collection URL. This is what stops a problem-aware searcher from
  bouncing off a generic homepage.

  COMPLIANCE: naming a condition for NAVIGATION is allowed — the card title
  describes what the shopper is looking for. Card body text must describe the
  product's FEATURES, never an effect on the body. "Cushioned heel and arch
  support" is fine; "relieves heel pain" is not. See COMPLIANCE.md.

  EMPTY-STATE GRACE: a card whose collection has no products is skipped, and the
  whole section hides if none are left — the store never shows an empty concern.
  A card given a custom URL is always shown, since an arbitrary link (e.g. a
  filtered collection URL) can't be counted.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .sw-problem-grid {
    --sw-problem-columns: {{ section.settings.columns_desktop }};
  }

  #shopify-section-{{ section.id }} .sw-problem-section__image {
    opacity: {{ section.settings.background_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # EMPTY-STATE GRACE: a card pointing at an empty collection is skipped, and
  # the section hides entirely if nothing is left. A card with a custom URL
  # cannot be counted (we can't know what's behind an arbitrary link) so it is
  # always shown — that's the escape hatch for filtered URLs.
  assign visible_cards = 0
  for block in section.blocks
    if block.settings.link != blank
      assign visible_cards = visible_cards | plus: 1
    elsif block.settings.collection != blank and block.settings.collection.all_products_count > 0
      assign visible_cards = visible_cards | plus: 1
    endif
  endfor
-%}

{%- if visible_cards > 0 -%}
<div class="sw-problem-section color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.show_background -%}
    {%- render 'stridewell-image',
      image: section.settings.background_image,
      fallback: 'shop-by-problem.jpg',
      fallback_width: 1376,
      fallback_height: 768,
      class: 'sw-problem-section__image',
      sizes: '100vw'
    -%}
  {%- endif -%}

  <div
    class="sw-problem-section__inner page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin{% if section.settings.center_heading %} sw-center sw-measure{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="rte sw-muted">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sw-problem-grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_url = block.settings.link

            if card_url == blank
              # No custom URL: require a collection that actually has products.
              unless block.settings.collection != blank and block.settings.collection.all_products_count > 0
                continue
              endunless
              assign card_url = block.settings.collection.url
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ card_url }}" class="sw-problem-card">

            {%- if block.settings.icon != blank -%}
              <span class="sw-problem-card__icon">
                {%- render 'stridewell-icon', icon: block.settings.icon, class: 'sw-icon--lg' -%}
              </span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="sw-problem-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="sw-problem-card__text sw-muted">{{ block.settings.text | escape }}</p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="sw-problem-card__cta">{{ block.settings.cta_label | escape }}</span>
            {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Shop by problem",
  "class": "section",
  "tag": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Name each card the way customers search. Point it at a collection, or paste a filtered collection URL such as /collections/insoles-arch-support?filter.p.tag=plantar-fasciitis"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by concern"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__4.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Pick your concern and we'll point you to the right support.</p>"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center the heading",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Cards per row on desktop",
      "default": 3
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show accent background image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Leave blank to use assets/shop-by-problem.jpg."
    },
    {
      "type": "range",
      "id": "background_opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "Background opacity",
      "info": "Keep this low so card text stays easy to read.",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Problem card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "arch", "label": "Arch" },
            { "value": "footprint", "label": "Footprint" },
            { "value": "wave", "label": "Circulation waves" },
            { "value": "knee", "label": "Knee" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "sock", "label": "Sock" },
            { "value": "cushion", "label": "Cushion" },
            { "value": "target", "label": "Target" },
            { "value": "heart", "label": "Heart" },
            { "value": "", "label": "No icon" }
          ],
          "default": "arch"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "info": "Use the customer's search words, e.g. \"Plantar fasciitis\". Titles may name a condition; the supporting line below must describe features only.",
          "default": "Plantar fasciitis"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting line",
          "info": "Features and materials only — no health outcomes.",
          "default": "Cushioned heel and arch support."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides the collection. Use for filtered URLs."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "Shop this"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by problem",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "arch",
            "title": "Plantar fasciitis",
            "text": "Cushioned heel and arch support.",
            "cta_label": "Shop this"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "footprint",
            "title": "Bunions",
            "text": "Gentle toe spacing and room where you need it.",
            "cta_label": "Shop this"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "wave",
            "title": "Swelling & circulation",
            "text": "Graduated compression knitwear.",
            "cta_label": "Shop this"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "cushion",
            "title": "Arch pain",
            "text": "Cushioned support that holds its shape all day.",
            "cta_label": "Shop this"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "knee",
            "title": "Knee support",
            "text": "Steady, low-profile support you can wear under clothes.",
            "cta_label": "Shop this"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "shoe",
            "title": "Wide-fit shoes",
            "text": "Everyday footwear with room for wide feet.",
            "cta_label": "Shop this"
          }
        }
      ]
    }
  ]
}
{% endschema %}
