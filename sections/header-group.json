      "settings": {
        "color_scheme": "scheme-3",
        "show_line_separator": false,
        "show_social": false,
        "auto_rotate": true,
        "change_slides_speed": 5,
        "enable_country_selector": false,
        "enable_language_selector": false
      },
      "blocks": {
        "announcement-shipping": {
          "type": "announcement",
          "settings": {
            "text": "Free US shipping over $50",
            "link": ""
          }
        },
        "announcement-sizing": {
          "type": "announcement",
          "settings": {
            "text": "Not sure which size? Email us before you order",
            "link": "/pages/contact"
          }
        },
        "announcement-nationwide": {
          "type": "announcement",
          "settings": {
            "text": "Ships to all 50 states, with tracking on every order",
            "link": ""
          }
        }
      },
      "block_order": [
