{%- comment -%}
  Sitewide trust bar. Icon + label blocks answering what a shopper checks before
  committing: shipping, tracking, checkout security, sizing.

  COMPLIANCE: operational facts only. No customer counts, no ratings, and no
  guarantee unless that exact policy is live in Settings → Policies.
  See COMPLIANCE.md.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .sw-trust-bar__list {
    --sw-trust-columns: {{ section.blocks.size | at_most: 4 | at_least: 1 }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="sw-trust-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.layout == 'stacked' %} sw-trust-bar--stacked{% endif %}">
    <div
      class="page-width section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="sw-center inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="sw-trust-bar__list" role="list">
        {%- for block in section.blocks -%}
          <li class="sw-trust-bar__item" {{ block.shopify_attributes }}>
            <span class="sw-trust-bar__icon">
              {%- render 'stridewell-icon', icon: block.settings.icon, class: 'sw-icon--lg' -%}
            </span>
            <span>
              {%- if block.settings.label != blank -%}
                <span class="sw-trust-bar__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}
              {%- if block.settings.sublabel != blank -%}
                <span class="sw-trust-bar__sublabel sw-muted">{{ block.settings.sublabel | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust bar",
  "class": "section",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Use operational facts you can evidence: free shipping threshold, tracking, secure checkout, sizing help. Never a customer count, a rating, or a guarantee that is not live in Settings → Policies. See COMPLIANCE.md."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Usually left blank so the bar stays quiet."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "inline", "label": "Icon beside text" },
        { "value": "stacked", "label": "Icon above text" }
      ],
      "default": "inline",
      "label": "Item layout"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "shield-check", "label": "Shield with check" },
            { "value": "users", "label": "Customers" },
            { "value": "ruler", "label": "Sizing ruler" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Secure checkout" },
            { "value": "clock", "label": "Clock" },
            { "value": "chat", "label": "Support chat" },
            { "value": "check-circle", "label": "Check in a circle" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free US shipping"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Supporting line",
          "default": "On orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "label": "Free US shipping",
            "sublabel": "On orders over $50"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "clock",
            "label": "Tracking on every order",
            "sublabel": "Emailed as soon as it ships"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "label": "Secure checkout",
            "sublabel": "Encrypted at every step"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "ruler",
            "label": "Sizing guide",
            "sublabel": "Check your fit before you order"
          }
        }
      ]
    }
  ]
}
{% endschema %}
