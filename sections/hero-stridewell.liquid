{%- comment -%}
  StrideWell hero.

  The fold's only job is to earn the scroll: outcome-led headline, one line of
  subcopy, one primary action, one secondary action, and a short reassurance
  row. Nothing else.

  Background defaults to assets/hero-home.jpg and degrades to the section's
  colour scheme background if that file is ever missing.
{%- endcomment -%}

{%- liquid
  # Build the scrim colour from .red/.green/.blue — the API layout/theme.liquid
  # itself uses for colour settings. `.rgb` only exists on swatch colours, not
  # on a `color` setting, so it yields an empty string here and would produce
  # `rgba(, 0.7)`: invalid CSS the browser silently drops, leaving the heading
  # unreadable over a bright photo.
  assign scrim_rgb = '14, 58, 70'
  if section.settings.scrim_color != blank
    assign scrim_r = section.settings.scrim_color.red
    assign scrim_g = section.settings.scrim_color.green
    assign scrim_b = section.settings.scrim_color.blue
    assign scrim_rgb = scrim_r | append: ', ' | append: scrim_g | append: ', ' | append: scrim_b
  endif
  assign scrim_alpha = section.settings.scrim_opacity | divided_by: 100.0
  assign scrim_alpha_fade = section.settings.scrim_opacity | times: 0.35 | divided_by: 100.0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sw-hero {
    min-height: {{ section.settings.height_mobile }}px;
  }

  #shopify-section-{{ section.id }} .sw-hero__scrim {
    {%- if section.settings.content_alignment == 'center' -%}
      background: rgba({{ scrim_rgb }}, {{ scrim_alpha }});
    {%- else -%}
      background: linear-gradient(
        to right,
        rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
        rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 42%,
        rgba({{ scrim_rgb }}, {{ scrim_alpha_fade }}) 100%
      );
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sw-hero {
      min-height: {{ section.settings.height_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="sw-hero color-{{ section.settings.color_scheme }} sw-hero--{{ section.settings.content_alignment }}">
  {%- render 'stridewell-image',
    image: section.settings.image,
    fallback: 'hero-home.jpg',
    fallback_width: 1376,
    fallback_height: 768,
    class: 'sw-hero__image',
    sizes: '100vw',
    alt: section.settings.image_alt,
    eager: true
  -%}

  <div class="sw-hero__scrim"></div>

  <div class="sw-hero__inner page-width">
    <div
      class="sw-hero__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- if section.settings.eyebrow != blank -%}
        <span class="sw-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sw-hero__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="sw-hero__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- liquid
        # The secondary button can be bound to a collection. When it is, the
        # button only renders while that collection actually has products, so a
        # "See best sellers" CTA can never land on an empty page.
        assign show_button_2 = false
        if section.settings.button_label_2 != blank
          assign show_button_2 = true
          assign button_2_url = section.settings.button_link_2

          if section.settings.button_collection_2 != blank
            if section.settings.button_collection_2.all_products_count > 0
              assign button_2_url = section.settings.button_collection_2.url
            else
              assign show_button_2 = false
            endif
          endif

          if button_2_url == blank
            assign button_2_url = routes.all_products_collection_url
          endif
        endif
      -%}

      {%- if section.settings.button_label_1 != blank or show_button_2 -%}
        <div class="sw-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
              class="button button--primary"
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if show_button_2 -%}
            <a href="{{ button_2_url }}" class="button button--secondary">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign reassurance = section.settings.reassurance | strip
      -%}
      {%- if reassurance != blank -%}
        <ul class="sw-hero__reassurance" role="list">
          {%- assign reassurance_items = reassurance | split: ',' -%}
          {%- for item in reassurance_items -%}
            {%- assign item_text = item | strip -%}
            {%- if item_text != blank -%}
              <li>
                {%- render 'stridewell-icon', icon: 'check', class: 'sw-icon--sm' -%}
                <span>{{ item_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero (StrideWell)",
  "class": "section section--hero",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave the image blank to use assets/hero-home.jpg. Keep the left third of the image clear so the headline stays readable."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank if the image is decorative."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Foot & leg support"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Comfort that keeps you moving."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "hxl", "label": "t:sections.all.heading_size.options__5.label" }
      ],
      "default": "h0",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Everyday support and comfort for your feet, arches and legs — made for people who are on their feet all day.</p>"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance row",
      "info": "Comma-separated. Each item gets a checkmark.",
      "default": "Free US shipping over $50, Tracking on every order, Secure checkout"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop foot support"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "See best sellers"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "collection",
      "id": "button_collection_2",
      "label": "Secondary button collection",
      "info": "Optional. If set, this is used as the link AND the button hides itself while that collection has no products — so \"See best sellers\" never leads to an empty page."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Content position"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Minimum height on mobile",
      "default": 480
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Minimum height on desktop",
      "default": 620
    },
    {
      "type": "header",
      "content": "Image overlay"
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Overlay color",
      "default": "#0E3A46"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "info": "Keeps the headline readable over the photo. Do not go below 65% with a bright image — the reassurance line is small text and needs a 4.5:1 contrast ratio.",
      "default": 70
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "Hero (StrideWell)"
    }
  ]
}
{% endschema %}
